@startuml uc-01-comptes-acces
!theme plain
skinparam nodesep 50
skinparam ranksep 40
title Cas d'utilisation — Comptes & accès (table users)

actor Administrateur
actor "Tout utilisateur\nconnecté" as AnyUser

rectangle "Comptes & accès" {
  usecase "Créer un utilisateur" as UC1
  usecase "Modifier un rôle" as UC2
  usecase "Désactiver un compte\n(soft-delete)" as UC3
  usecase "S'authentifier" as UC4
  usecase "Activer le MFA (TOTP)" as UC5
  usecase "Vérifier un code MFA" as UC6
  usecase "Journaliser l'action" as UC7
}

Administrateur -- UC1
Administrateur -- UC2
Administrateur -- UC3
AnyUser -- UC4
AnyUser -- UC5
AnyUser -- UC6

UC1 ..> UC7 : <<include>>
UC2 ..> UC7 : <<include>>
UC3 ..> UC7 : <<include>>
UC4 ..> UC7 : <<include>>

note right of UC3
  Ne supprime jamais la ligne :
  is_active passe à false,
  conservé pour l'audit.
end note

@enduml
